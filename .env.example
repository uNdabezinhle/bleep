# Public Bleep / Bleep-box environment
# Copy to .env next to docker-compose.yml. Never put real user mailboxes on a laptop "dev" that logs.

BLEEP_REGION=ZA-JHB
BLEEP_MAX_TTL_SECONDS=129600
BLEEP_ENVELOPE_MAX_BYTES=8388608
BLEEP_OPS_TOKEN=change-me-before-any-real-mailbox
BLEEP_TOKEN_SECRET=change-me-too-a-long-random-string

POSTGRES_USER=bleep
POSTGRES_PASSWORD=change-me-db
POSTGRES_DB=bleep

# TURN (calls). Names never go to coturn — only media + IPs.
TURN_USER=bleep
TURN_PASS=change-me-turn
TURN_REALM=bleep.za
