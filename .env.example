# Copy to .env on each VM. .env is gitignored. One file per box. Do not reuse secrets.

# test | pilot | prod
BLEEP_ENV=test
BLEEP_REGION=ZA-JHB

# openssl rand -hex 32
BLEEP_TOKEN_SECRET=
BLEEP_OPS_TOKEN=

POSTGRES_USER=bleep
POSTGRES_PASSWORD=
POSTGRES_DB=bleep

# Baked into the web image at build time (client/src/calls/ice.ts).
# Changing these later requires a web rebuild. Do not leave the defaults on a public box.
TURN_USER=bleep
TURN_PASS=
TURN_REALM=bleep.za
# Oracle guest address is private. PUBLIC/PRIVATE, both on this VM.
# Example: 129.151.1.2/10.0.0.5
TURN_EXTERNAL_IP=

# Hostname that points at this VM only. DNS only, not an HTTP proxy.
BLEEP_DOMAIN=test.example.com
BLEEP_ACME_EMAIL=you@example.com

# Host path for deploy/backup.sh. On production, mount the spare 50 GB volume here.
BLEEP_BACKUP_DIR=/var/backups/bleep
